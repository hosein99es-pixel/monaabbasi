---
// A photograph in a vintage slide mount: warm glow, soft vignette, optional mono label.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PREVIEW } from '../consts';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  label?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  class?: string;
}
const { src, alt, sizes = '(max-width: 900px) 100vw, 50vw', widths = [480, 800, 1200, 1600], label, loading = 'lazy', priority = false, class: cls } = Astro.props;
let w = widths.filter((n) => n <= src.width);
if (!w.length || w[w.length - 1] < src.width) w.push(Math.min(src.width, 1800));
if (PREVIEW) w = [Math.min(src.width, 1200)];
---
<figure class:list={['slide', cls]}>
  <Picture
    src={src}
    alt={alt}
    widths={w}
    sizes={sizes}
    formats={PREVIEW ? ['webp'] : ['avif', 'webp']}
    fallbackFormat={PREVIEW ? 'webp' : undefined}
    class="slide__img"
    loading={priority ? 'eager' : loading}
    fetchpriority={priority ? 'high' : undefined}
  />
  {label && <figcaption set:html={label} />}
</figure>
