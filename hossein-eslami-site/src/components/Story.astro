---
// Project text: sticky heading column + body, with photographs cut into expressive shapes.
import Pic from './Pic.astro';
import { onColor } from '../lib/color';
import type { ImageMetadata } from 'astro';
interface Photo { src: ImageMetadata; alt: string; shape?: string }
interface Props {
  no: string;
  title: string;
  lede: string;
  facts: { k: string; v: string }[];
  credits: { role: string; name: string }[];
  photos?: Photo[];
  accent: string;
  container: string;
  id?: string;
}
const { no, title, lede, facts, credits, photos = [], accent, container, id } = Astro.props;
---
<section class="story" id={id} data-accent={accent} style={`--acc:${accent};--accc:${container};--on-acc:${onColor(accent)}`}>
  <div class="story__grid wrap">
    <div class="story__head">
      <p class="label">{no}</p>
      <h2 class="story__title">{title}</h2>
      <p class="story__lede">{lede}</p>
      <dl class="facts">
        {facts.filter((f) => f.v.trim()).map((f) => (
          <div><dt class="label">{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>
    <div class="story__body">
      <div class="prose rv"><slot /></div>
      {photos.length > 0 && (
        <div class="story__photos">
          {photos.map((ph, i) => (
            <figure class:list={['story__ph', 'rv', `shape-${ph.shape ?? 'rounded'}`, `n${i}`]}>
              <Pic src={ph.src} alt={ph.alt} sizes="(max-width: 900px) 90vw, 30vw" widths={[500, 900]} />
            </figure>
          ))}
        </div>
      )}
      <dl class="credits rv">
        {credits.filter((c) => c.name.trim()).map((c) => (
          <div><dt class="label">{c.role}</dt><dd>{c.name}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>
