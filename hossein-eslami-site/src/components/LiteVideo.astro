---
// Click-to-load video: nothing from YouTube/Vimeo is requested until the visitor presses play.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { url: string; poster: ImageMetadata; title: string }
const { url, poster, title } = Astro.props;
let embed = '';
const yt = url.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);
const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
if (yt) embed = `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0`;
else if (vm) embed = `https://player.vimeo.com/video/${vm[1]}?autoplay=1&dnt=1`;
const img = await getImage({ src: poster, width: 1280, format: 'webp' });
---
{embed && (
  <button class="lite-video" type="button" data-embed={embed} data-title={title} aria-label={`Play video: ${title}`}>
    <img src={img.src} alt="" loading="lazy" decoding="async" />
    <span>▶&nbsp; Play video</span>
  </button>
)}
<script>
  document.querySelectorAll<HTMLButtonElement>('.lite-video').forEach((b) =>
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = b.dataset.embed!;
      f.title = b.dataset.title!;
      f.allow = 'autoplay; fullscreen; picture-in-picture';
      f.allowFullscreen = true;
      b.replaceChildren(f);
    }, { once: true }),
  );
</script>
