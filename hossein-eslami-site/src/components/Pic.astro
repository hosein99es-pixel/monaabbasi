---
// Responsive, optimised image (AVIF/WebP). In the chat-preview build only one WebP size is emitted.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PREVIEW } from '../consts';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  style?: string;
  eager?: boolean;
}
const { src, alt, sizes = '100vw', widths = [640, 1000, 1600], class: cls, style, eager = false } = Astro.props;
let w = widths.filter((n) => n < src.width);
w.push(Math.min(src.width, 1800));
if (PREVIEW) w = [Math.min(src.width, widths[widths.length - 1] >= 1400 ? 1600 : 1000)];
---
<Picture
  src={src}
  alt={alt}
  widths={[...new Set(w)]}
  sizes={sizes}
  formats={PREVIEW ? ['webp'] : ['avif', 'webp']}
  fallbackFormat={PREVIEW ? 'webp' : undefined}
  class={cls}
  style={style}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
