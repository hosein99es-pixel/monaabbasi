---
// Apple-style horizontal filmstrip: vertical scroll moves the strip sideways.
// The footer says so in words, counts the photos and offers arrow buttons, so nobody is left guessing.
import Pic from './Pic.astro';
import type { ImageMetadata } from 'astro';
interface Item { src: ImageMetadata; alt: string; caption?: string; shape?: string }
interface Props { title: string; kicker?: string; items: Item[]; accent?: string }
const { title, kicker, items, accent } = Astro.props;
const total = String(items.length).padStart(2, '0');
---
<section class="hg" data-scene data-hg data-accent={accent} style={accent ? `--acc:${accent}` : undefined} aria-label={title}>
  <div class="hg__pin">
    <div class="hg__head">
      {kicker && <p class="label">{kicker}</p>}
      <h3 class="hg__title">{title}</h3>
    </div>
    <ul class="hg__track" role="list">
      {items.map((it, i) => (
        <li class:list={['hg__item', it.shape && `shape-${it.shape}`]} style={`--ar:${(it.src.width / it.src.height).toFixed(3)}`}>
          <Pic src={it.src} alt={it.alt} sizes="(max-width: 700px) 80vw, 45vw" widths={[600, 1000]} />
          <span class="hg__cap label">{String(i + 1).padStart(2, '0')}{it.caption ? ` · ${it.caption}` : ''}</span>
        </li>
      ))}
    </ul>
    <div class="hg__foot">
      <p class="hg__hint" aria-hidden="true">
        <span class="hg__arrow"><i>↓</i><i>→</i></span>
        <span class="hg__say hg__say--go">Keep scrolling down. The photos slide sideways.</span>
        <span class="hg__say hg__say--end">That’s all. Keep scrolling down.</span>
      </p>
      <div class="hg__rail" aria-hidden="true"><span></span></div>
      <div class="hg__nav">
        <button class="hg__btn" type="button" data-dir="-1" aria-label="Previous photo">←</button>
        <span class="hg__count label" aria-live="polite"><b>01</b> / {total}</span>
        <button class="hg__btn" type="button" data-dir="1" aria-label="Next photo">→</button>
      </div>
    </div>
  </div>
</section>
