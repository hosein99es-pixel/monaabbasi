---
import Base from '../layouts/Base.astro';
import Tickets from '../components/Tickets.astro';
import { EMAIL, LINKEDIN, LOCATION } from '../consts';
---
<Base title="Contact" description="Contact Mohammad Hossein Eslami for festivals, residencies, collaborations and academic enquiries.">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">✦ Contact</p>
      <h1>Contact</h1>
      <p>For festivals, residencies, collaborations and academic enquiries.</p>
    </header>
    <a class="contact-big" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <dl class="facts">
      <div><dt>LinkedIn</dt><dd><a href={LINKEDIN} rel="me noopener" target="_blank">linkedin.com/in/hosein-eslami</a></dd></div>
      <div><dt>Based in</dt><dd>{LOCATION}</dd></div>
      <div><dt>Languages</dt><dd>English · Persian</dd></div>
    </dl>
    <section class="section" aria-labelledby="dl-title">
      <div class="section__head"><h2 id="dl-title">CV &amp; Portfolio</h2></div>
      <Tickets />
    </section>
  </div>
</Base>
