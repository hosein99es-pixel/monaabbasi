---
import Base from '../../layouts/Base.astro';
import Slide from '../../components/Slide.astro';
import LiteVideo from '../../components/LiteVideo.astro';
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import { getWorks, type Work } from '../../lib/works';
import { html, visible, pad, clean } from '../../lib/text';
import { NAME, SHOW_PLACEHOLDERS, PREVIEW } from '../../consts';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({
    params: { slug: work.id },
    props: { work, prev: works[i - 1] ?? works[works.length - 1], next: works[i + 1] ?? works[0] },
  }));
}
interface Props { work: Work; prev: Work; next: Work }
const { work, prev, next } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const draft = (field: string) => d.draft_translation.includes(field);

const specs = [
  { k: 'Year', v: d.month ? `${d.month} ${d.year}` : String(d.year) },
  { k: 'Venue', v: d.venue, draft: draft('venue') },
  { k: 'City', v: d.city },
  { k: d.roles.length > 1 ? 'Roles' : 'Role', v: d.roles.join(', ') },
  { k: 'Text', v: d.author },
  { k: 'Duration', v: d.duration },
].filter((s) => visible(s.v));

const archive = await Promise.all(
  d.archive.map(async (a) => ({
    ...a,
    thumb: (await getImage({ src: a.src, width: 320, height: 320, fit: 'cover', format: 'webp' })).src,
    full: (await getImage({ src: a.src, width: Math.min(a.src.width, PREVIEW ? 1400 : 1800), format: 'webp' })).src,
  })),
);

const og = PREVIEW ? { src: '/' } : await getImage({ src: d.cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  url: new URL(`/works/${work.id}/`, Astro.site).href,
  image: new URL(og.src, Astro.site).href,
  dateCreated: String(d.year),
  description: d.summary,
  genre: d.category.join(', '),
  creator: { '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name: NAME },
  ...(clean(d.author) && { author: clean(d.author) }),
  ...(clean(d.venue) && {
    locationCreated: { '@type': 'Place', name: clean(d.venue), address: { '@type': 'PostalAddress', addressLocality: d.city } },
  }),
  contributor: d.credits.filter((c) => clean(c.name)).map((c) => ({ '@type': 'Role', roleName: c.role, name: clean(c.name) })),
};
const portrait = (w: number, h: number) => h > w * 1.05;
---
<Base title={d.title} description={`${d.title} (${d.year}) — ${d.summary}`} image={d.cover.src} imageAlt={d.cover.alt} type="article" jsonLd={jsonLd}>
  <article>
    <header class="work-hero">
      <div class="work-hero__img">
        <Picture src={d.cover.src} alt={d.cover.alt} widths={PREVIEW ? [Math.min(1200, d.cover.src.width)] : [640, 1024, 1440, 1800].filter((w) => w <= d.cover.src.width)} sizes="100vw" formats={PREVIEW ? ['webp'] : ['avif', 'webp']} fallbackFormat={PREVIEW ? 'webp' : undefined} loading="eager" fetchpriority="high" />
      </div>
      <div class="work-hero__text wrap">
        <p class="kicker">No. {pad(d.order)} · {d.category.map((c) => c.replace('-', ' ')).join(' · ')}</p>
        {d.status && <p class="status">{d.status}</p>}
        <h1>{d.title}</h1>
        <p class="work-hero__meta mono">
          <span>{d.year}</span>
          {visible(d.venue) && <span set:html={html(`${d.venue}, ${d.city}`)} />}
          <span>{d.roles.join(' · ')}</span>
        </p>
      </div>
    </header>

    <div class="wrap">
      <section class="dossier" aria-label="About the work">
        <dl class="specs">
          {specs.map((s) => (
            <div>
              <dt>{s.k}</dt>
              <dd><Fragment set:html={html(s.v)} />{s.draft && <> <span class="draft-badge">[DRAFT TRANSLATION – needs review]</span></>}</dd>
            </div>
          ))}
        </dl>
        <div class="prose reveal">
          {draft('body') && <p class="draft-badge">[DRAFT TRANSLATION – needs review]</p>}
          <Content />
        </div>
      </section>

      {d.gallery.length > 0 && (
        <section class="sequence" aria-label="Images">
          {d.gallery.map((g, i) => {
            const isDrawing = g.src.src.includes('set-elevation') || g.src.src.includes('puppet-stage');
            return (
              <Slide
                class:list={['seq', 'reveal', { 'seq--portrait': portrait(g.src.width, g.src.height), fit: isDrawing, 'seq--center': isDrawing }]}
                src={g.src}
                alt={g.alt}
                sizes={portrait(g.src.width, g.src.height) ? '(max-width: 820px) 100vw, 560px' : '(max-width: 1240px) 100vw, 1180px'}
                label={`Fig. ${pad(i + 1)}${g.caption ? ` — ${g.caption}` : ''}`}
              />
            );
          })}
        </section>
      )}

      {d.video_url && (
        <section class="section" aria-labelledby="video-title">
          <div class="section__head"><h2 id="video-title">Video</h2></div>
          <LiteVideo url={d.video_url} poster={d.cover.src} title={d.title} />
        </section>
      )}
      {!d.video_url && SHOW_PLACEHOLDERS && (
        <section class="section"><div class="section__head"><h2>Video</h2></div><p><span class="ph">[VIDEO_URL]</span></p></section>
      )}

      {archive.length > 0 && (
        <section class="section" aria-labelledby="sheet-title">
          <div class="section__head">
            <h2 id="sheet-title">Contact sheet</h2>
            <span class="mono muted">{archive.length} more photographs</span>
          </div>
          <div class="contact-sheet">
            {archive.map((a, i) => (
              <a href={a.full} data-lightbox data-alt={a.alt}>
                <img src={a.thumb} alt={a.alt} width="320" height="320" loading="lazy" decoding="async" />
                <span aria-hidden="true">{pad(i + 1)}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="section" aria-labelledby="credits-title">
        <div class="section__head"><h2 id="credits-title">Credits</h2></div>
        <dl class="credits">
          {d.credits.filter((c) => visible(c.name)).map((c) => (
            <div><dt>{c.role}</dt><dd set:html={html(c.name)} /></div>
          ))}
        </dl>
      </section>

      {(d.press.length > 0 || SHOW_PLACEHOLDERS) && (
        <section class="section" aria-labelledby="press-title">
          <div class="section__head"><h2 id="press-title">Press</h2></div>
          {d.press.length > 0 ? (
            d.press.map((p) => (
              <div class="press-item">
                {p.quote && <blockquote>“{p.quote}”</blockquote>}
                <p class="mono">{p.url ? <a href={p.url} target="_blank" rel="noopener">{p.source}{p.title && `, ${p.title}`}</a> : p.source}{p.date && ` · ${p.date}`}</p>
              </div>
            ))
          ) : (
            <p><span class="ph">[PRESS]</span></p>
          )}
        </section>
      )}

      {(d.brochure_pdf || SHOW_PLACEHOLDERS) && (
        <section class="section">
          {d.brochure_pdf ? <a class="btn" href={d.brochure_pdf} download>Programme / brochure (PDF)</a> : <p><span class="ph">[BROCHURE_PDF]</span></p>}
        </section>
      )}

      <nav class="pager" aria-label="More works">
        <a href={`/works/${prev.id}/`}><span class="mono muted">← Previous</span><strong>{prev.data.title}</strong></a>
        <a href={`/works/${next.id}/`}><span class="mono muted">Next →</span><strong>{next.data.title}</strong></a>
      </nav>
    </div>
  </article>

  <dialog class="lightbox" aria-label="Photograph">
    <img alt="" />
    <div class="lightbox__bar">
      <button type="button" data-lb="prev">← Prev</button>
      <span class="mono muted" data-lb-count></span>
      <button type="button" data-lb="next">Next →</button>
      <button type="button" data-lb="close">Close ✕</button>
    </div>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]')];
  if (dlg && links.length && 'showModal' in dlg) {
    const img = dlg.querySelector('img')!;
    const count = dlg.querySelector('[data-lb-count]')!;
    let i = 0;
    const open = (k: number) => {
      i = (k + links.length) % links.length;
      img.src = links[i].href;
      img.alt = links[i].dataset.alt ?? '';
      count.textContent = `${i + 1} / ${links.length}`;
      if (!dlg.open) dlg.showModal();
    };
    links.forEach((a, k) => a.addEventListener('click', (e) => { e.preventDefault(); open(k); }));
    dlg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (b?.dataset.lb === 'prev') open(i - 1);
      else if (b?.dataset.lb === 'next') open(i + 1);
      else if (b?.dataset.lb === 'close' || e.target === dlg) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') open(i - 1);
      if (e.key === 'ArrowRight') open(i + 1);
    });
    dlg.addEventListener('close', () => links[i]?.focus());
  }
</script>
