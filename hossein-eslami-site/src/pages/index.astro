---
import Base from '../layouts/Base.astro';
import Projector from '../components/Projector.astro';
import Slide from '../components/Slide.astro';
import Tickets from '../components/Tickets.astro';
import { Image } from 'astro:assets';
import { getWorks } from '../lib/works';
import { pad } from '../lib/text';
import { person } from '../lib/schema';
import portrait from '../assets/portrait.jpg';
import { NAME, TAGLINE, PREVIEW } from '../consts';

const works = await getWorks();
const W = Object.fromEntries(works.map((w) => [w.id, w]));
const no = (id: string) => pad(W[id].data.order);
const url = (id: string) => `/works/${id}/`;
const pic = (id: string, i: number) => W[id].data.gallery[i];

// Scroll-telling sequence: each step projects one image; text comes from the works themselves.
const steps = [
  { id: 'mephisto-for-ever', img: pic('mephisto-for-ever', 0), text: 'An actor makes a deal with power so he can stay on stage. What is left of art once beauty starts working for those in control?' },
  { id: 'mephisto-for-ever', img: pic('mephisto-for-ever', 5), kicker: 'A troupe performing itself', text: 'Classical and modern acting, puppetry and contemporary dance sit side by side; scenes of power are carried by bodies, distance and image rather than words.' },
  { id: 'mephisto-for-ever', img: pic('mephisto-for-ever', 6), fit: true, kicker: 'Set design', text: 'One-metre cubes, a trussed arch and a stepped platform build a second, smaller stage inside the stage.' },
  { id: 'in-front-of-city-theater', img: pic('in-front-of-city-theater', 0), text: "The life of Sohrab A'raabi, killed in the protests that followed Iran's 2009 election, told in four episodes by the people closest to him." },
  { id: 'in-front-of-city-theater', img: pic('in-front-of-city-theater', 4), kicker: 'Choreography & live music', text: "Two actors play two sides of one character in a duet built on Pina Bausch's trust exercises; five songs composed in rehearsal mix alternative rock and Persian folk music." },
  { id: 'maid-to-marry', img: pic('maid-to-marry', 0), text: 'A cyber version of the script on monitors, the play on stage, and seven teenagers playing board games and describing their day, all at the same time.' },
  { id: 'asgardia', img: pic('asgardia', 0), text: 'Six strangers on a mission to the first nation in space, intercut with a mythic line drawn from the story of Adam and Eve.' },
  { id: 'the-good-person-of-szechwan', img: pic('the-good-person-of-szechwan', 0), text: "A wooden floor tuned to sound under the actors' feet, so that bodies and ground became a kind of music." },
  { id: 'mixed-sandwich', img: pic('mixed-sandwich', 0), text: 'Media production and live projection for an independent, underground performance.' },
];
---
<Base intro jsonLd={person(Astro.site!)}>
  <Projector slot="before" />

  <section class="hero" aria-labelledby="hero-name">
    <div class="hero__name">
      <h1 id="hero-name" data-spot>{NAME}</h1>
      <p>{TAGLINE}. Postdramatic and intermedial performance, Tehran.</p>
    </div>
    <div class="wall">
      <a class="wall__item w1" href={url('mephisto-for-ever')} data-spot>
        <Slide src={pic('mephisto-for-ever', 0).src} alt={pic('mephisto-for-ever', 0).alt} sizes="(max-width: 900px) 62vw, 25vw" priority label={`No. ${no('mephisto-for-ever')} · 2026 · In rehearsal`} />
      </a>
      <a class="wall__item wall__title wall__title--xl w2" href={url('mephisto-for-ever')} data-spot>Mephisto<br />For Ever</a>
      <a class="wall__item w3" href={url('in-front-of-city-theater')}>
        <Slide src={pic('in-front-of-city-theater', 0).src} alt={pic('in-front-of-city-theater', 0).alt} sizes="(max-width: 900px) 54vw, 21vw" label={`No. ${no('in-front-of-city-theater')} · 2018`} />
      </a>
      <a class="wall__item wall__title wall__title--l w4" href={url('in-front-of-city-theater')} data-spot>In Front of<br />City Theater<small>Director · Co-scene designer</small></a>
      <a class="wall__item w5" href={url('maid-to-marry')}>
        <Slide src={pic('maid-to-marry', 1).src} alt={pic('maid-to-marry', 1).alt} sizes="(max-width: 900px) 70vw, 19vw" label={`No. ${no('maid-to-marry')} · 2023`} />
      </a>
      <a class="wall__item wall__title wall__title--l w6" href={url('maid-to-marry')}>Maid to Marry</a>
      <a class="wall__item wall__title wall__title--m w7" href={url('asgardia')}>Asgardia<small>2016</small></a>
      <a class="wall__item wall__title wall__title--s w8" href={url('the-good-person-of-szechwan')}>The Good Person<br />of Szechwan<small>Set design · 2022</small></a>
      <a class="wall__item wall__title wall__title--s w9" href={url('the-proposal')}>The Proposal</a>
      <a class="wall__item wall__title wall__title--s w10" href={url('mixed-sandwich')}>Mixed Sandwich<small>Media · 2024</small></a>
      <a class="wall__item wall__title wall__title--s w11" href={url('king-lear')}>King Lear</a>
    </div>
  </section>

  <section class="statement wrap" aria-label="Statement">
    <p class="kicker reveal">✦ Practice</p>
    <p class="statement__text reveal">My work moves between text-based theatre, devised ensemble work, live music, contemporary dance and <em>media</em>.</p>
    <p class="statement__sub reveal">I am drawn to postdramatic and political theatre and to intermediality, and I often design the scenography of my own productions.</p>
  </section>

  <section class="programme wrap" aria-labelledby="programme-title">
    <div class="programme__head">
      <h2 id="programme-title">The Programme</h2>
      <a class="mono" href="/works/">All works →</a>
    </div>
    <div class="programme__grid">
      <div class="screen" aria-hidden="true">
        <div class="screen__frame">
          {steps.map((s, i) => (
            <div class:list={['screen__slide', { 'is-active': i === 0, fit: s.fit }]} data-i={i}>
              <Image src={s.img.src} alt="" widths={PREVIEW ? [1000] : [640, 1000, 1400]} sizes="(max-width: 900px) 100vw, 56vw" loading={i < 2 ? 'eager' : 'lazy'} />
            </div>
          ))}
          <div class="screen__shutter"></div>
        </div>
        <div class="screen__meta mono">
          <span>Slide projector</span>
          <span class="screen__count"><span data-count>01</span> / {pad(steps.length)}</span>
        </div>
      </div>
      <ol class="steps" role="list">
        {steps.map((s, i) => {
          const w = W[s.id].data;
          return (
            <li class:list={['step', { 'is-active': i === 0 }]} data-i={i}>
              <div>
                <p class="step__no">No. {pad(w.order)}{s.kicker ? ` — ${s.kicker}` : ''}</p>
                <h3><a href={url(s.id)}>{w.title}</a></h3>
                <p class="step__meta mono">{w.year} · {w.venue.startsWith('[') ? w.city : `${w.venue}, ${w.city}`} · {w.roles.join(', ')}</p>
                <p>{s.text}</p>
                <a class="step__link" href={url(s.id)}>View the work<span class="sr-only">: {w.title}</span> →</a>
                <span class="sr-only">Image: {s.img.alt}</span>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section wrap" id="downloads" aria-labelledby="dl-title">
    <div class="section__head">
      <h2 id="dl-title">Take the programme home</h2>
      <span class="mono muted">Downloads</span>
    </div>
    <Tickets />
  </section>

  <section class="section wrap" aria-labelledby="about-teaser">
    <div class="about">
      <div class="reveal">
        <Slide src={portrait} alt={`Black-and-white portrait of ${NAME}`} sizes="(max-width: 820px) 90vw, 36vw" widths={[400, 700, 1000]} />
      </div>
      <div class="reveal">
        <p class="kicker">✦ About</p>
        <h2 id="about-teaser" class="lede">I am a theatre director, dramaturg and video-mapping artist based in Tehran.</h2>
        <p>I hold an MA in Theatre Directing from Tehran University of Art, where my thesis studied the representation of identity in the work of Elizabeth LeCompte. Before theatre I studied software engineering, and that background still shapes the way I bring media onto the stage.</p>
        <p><a class="btn" href="/about/">Full biography</a>&nbsp; <a class="btn" href="/contact/">Contact</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Scroll-telling: the step in the middle of the viewport decides which slide is projected.
  const screen = document.querySelector<HTMLElement>('.screen');
  const slides = document.querySelectorAll<HTMLElement>('.screen__slide');
  const steps = document.querySelectorAll<HTMLElement>('.step');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let current = 0;
  const show = (i: number) => {
    if (i === current) return;
    current = i;
    slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
    steps.forEach((s, k) => s.classList.toggle('is-active', k === i));
    if (count) count.textContent = String(i + 1).padStart(2, '0');
    if (screen && !calm) {
      screen.classList.remove('is-changing');
      void screen.offsetWidth;
      screen.classList.add('is-changing');
    }
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && show(Number((e.target as HTMLElement).dataset.i))),
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>
