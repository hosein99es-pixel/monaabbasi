---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SHOW_PLACEHOLDERS } from '../consts';

const entries = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<Base title="Writing & Research" theme="paper" description="Thesis, articles and dramaturgical notes by Mohammad Hossein Eslami, including research on Elizabeth LeCompte and The Wooster Group.">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">✦ Writing &amp; Research</p>
      <h1>Writing</h1>
      <p>Research on identity and mediation in the work of Elizabeth LeCompte and The Wooster Group, dramaturgical notes, and papers written during my MA.</p>
    </header>
    <ol class="entries" role="list">
      {rendered.map(({ e, Content }) => {
        const d = e.data;
        return (
          <li class="entry reveal">
            <div>
              <p class="entry__type">{d.type}</p>
              <p class="entry__year">{d.year}</p>
            </div>
            <div>
              <h2>{d.title}</h2>
              <p class="entry__meta">
                {[d.coauthors, d.institution, d.advisors && `Advisors: ${d.advisors}`, d.status].filter(Boolean).join(' · ')}
              </p>
              <div class="entry__body"><Content /></div>
              <div class="entry__actions">
                {d.pdf ? (
                  <a class="btn" href={d.pdf} download>Download PDF</a>
                ) : (
                  SHOW_PLACEHOLDERS && <span class="btn" aria-disabled="true">PDF <span class="ph">[PDF]</span></span>
                )}
                {d.related_work && <a class="btn" href={`/works/${d.related_work}/`}>Related work →</a>}
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</Base>
