{
  "name": "monaabbasi",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "dev:migration": "SANITY_STUDIO_DATASET=migration-test sanity dev",
    "schema:validate": "sanity schemas validate",
    "test": "node --test components/*.test.mjs",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "typegen:check": "npm run typegen && git diff --exit-code -- schema.json ../web/sanity.types.ts",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/markdown": "^1.4.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.2.0",
    "@sanity/vision": "^6.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.1.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
